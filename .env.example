# noirdeck configuration — copy to .env and adjust. No secrets live here by design.

# Port on 127.0.0.1 (never bound wider; see docs/SECURITY.md)
NOIRDECK_PORT=4747

# Claude Code home to read (must exist; startup fails closed if missing)
NOIRDECK_CLAUDE_DIR=~/.claude

# Where project repos live, for the fleet board and QA gates
NOIRDECK_PROJECTS_DIR=~/projects

# Derived-data SQLite (rebuildable cache + proposals). Relative to repo root.
NOIRDECK_DB_PATH=data/noirdeck.db

# LLM mining is OFF unless this is exactly "true" (fail-closed arming flag)
NOIRDECK_MINING_ARMED=false

# Max transcript batches per mining run (cost/runaway guard)
NOIRDECK_MINE_MAX_BATCHES=8

# Overnight queue is OFF unless this is exactly "true" (fail-closed arming flag);
# runs additionally need a live arming contract created in the Queue view
NOIRDECK_OVERNIGHT_ARMED=false

# Primary memory namespace proposals may write to (default: derived from $HOME)
#NOIRDECK_PRIMARY_NAMESPACE=

# Vault — encrypted offsite backup (restic). Unset = vault disabled.
#NOIRDECK_VAULT_REPO=sftp:your-backup-host:offsite-backups/noirdeck-vault
#NOIRDECK_VAULT_PASSFILE=~/.config/noirdeck/vault-pass

# Improve — local-model repo improvement (fail-closed)
#NOIRDECK_IMPROVER_ARMED=false
#NOIRDECK_LOCAL_MODEL=qwen2.5-coder:7b
#NOIRDECK_OLLAMA_URL=http://127.0.0.1:11434
