[Unit]
Description=Scan ~/.claude for cleartext credentials daily at 02:00 NZ time
# Deliberately BEFORE mining (02:30): the miner reads the same tree and ships
# excerpts to an LLM, so a leaked credential should be flagged before that runs.

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true

[Install]
WantedBy=timers.target
