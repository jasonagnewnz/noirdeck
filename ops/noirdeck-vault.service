[Unit]
Description=noirdeck vault — encrypted offsite backup with verified restore

[Service]
Type=oneshot
# adjust to your clone location
WorkingDirectory=%h/noirdeck/backend
EnvironmentFile=-%h/noirdeck/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/noirdeck/.venv/bin/python -m noirdeck.vault
StandardOutput=journal
